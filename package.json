{
  "name": "swil-news",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.27.0",
  "scripts": {
    "build:news-index": "node scripts/build-news-index.mjs",
    "build:rollups": "node scripts/build-rollups.mjs",
    "build:events": "node scripts/build-events.mjs",
    "build:search-index": "node scripts/build-search-index.mjs",
    "validate:news-layout": "node scripts/validate-news-layout.mjs",
    "validate:news-content": "node scripts/validate-news-content.mjs",
    "validate:news-content:strict": "NEWS_CONTENT_VALIDATION_MODE=strict node scripts/validate-news-content.mjs",
    "validate:news-content:warn": "NEWS_CONTENT_VALIDATION_MODE=warn node scripts/validate-news-content.mjs",
    "validate:news-content:update-baseline": "node scripts/validate-news-content.mjs --update-baseline",
    "validate:news": "pnpm validate:news-layout && pnpm validate:news-content",
    "check-links": "node scripts/check-links.mjs",
    "dev": "next dev --port 3011",
    "predev": "pnpm build:news-index && pnpm build:rollups && pnpm build:events",
    "prebuild": "pnpm validate:news && pnpm build:news-index && pnpm build:rollups && pnpm build:events && pnpm build:search-index",
    "build": "next build",
    "postbuild": "node scripts/verify-build-trace.mjs",
    "verify:build-trace": "node scripts/verify-build-trace.mjs",
    "prestart": "pnpm build:news-index && pnpm build:rollups && pnpm build:events",
    "start": "next start",
    "lint": "eslint .",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "prepush": "pnpm validate:news && pnpm lint && pnpm test",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@vercel/analytics": "^1.6.1",
    "@vercel/speed-insights": "^2.0.0",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.577.0",
    "next": "^16.1.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.1",
    "@types/node": "^25.3.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.1.6",
    "pagefind": "^1.5.2",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3"
  }
}
