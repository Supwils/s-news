# Copy to `.env` and fill in. `.env` and every `.env.*` are gitignored; this
# file is the only one that is committed, so never put a real value in it.
#
# The site itself needs none of these. Every variable here belongs to the daily
# content pipeline (scripts/daily-news-and-commit.sh) or to a maintenance
# endpoint. `pnpm dev` and `pnpm build` work with this file absent.

# --- Content generation -------------------------------------------------------

# Cursor CLI key, used by scripts/news-agent.sh to run the digest agent.
# Required only when NEWS_AGENT_BACKEND=cursor (the default).
# Set NEWS_AGENT_BACKEND=noop to exercise the whole pipeline without an agent or
# a key; it writes nothing and is expected to fail the >=7/10 topic threshold.
CURSOR_API_KEY=

# --- Notifications ------------------------------------------------------------

# Resend API key. Absent, the pipeline skips email and still runs.
RESEND_API_KEY=

# Recipient for pipeline success/failure mail. No default on purpose: a default
# in a public repository is a personal address handed to every scraper. Absent,
# email is skipped.
DAILY_NEWS_NOTIFY_TO=

# Sender. Resend only delivers to the account's own address until you verify a
# domain at https://resend.com/domains, then point this at that domain.
# Defaults to "Swil-News <onboarding@resend.dev>".
DAILY_NEWS_NOTIFY_FROM=

# --- Site ---------------------------------------------------------------------

# Canonical origin for sitemap, RSS, robots and Open Graph URLs.
# Defaults to the deployment URL, or http://localhost:3011 outside Vercel.
SITE_URL=

# --- Maintenance endpoints ----------------------------------------------------

# Shared secret for POST /api/revalidate. Unset, that route rejects every
# request — it fails closed, so leaving this blank disables the endpoint.
REVALIDATE_TOKEN=

# Host allowed to reach POST /api/runtime/generate, which executes the
# generation shell scripts. Unset, only localhost is accepted, and the route is
# refused outright whenever VERCEL is set. Leave blank unless you know why.
ALLOWED_RUNTIME_HOST=
